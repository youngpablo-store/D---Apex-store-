<script>
document.getElementById('orderDate').valueAsDate=new Date();
function calc(){
let pt=0,jt=0;
document.querySelectorAll('#products tr').forEach((r,i)=>{if(i==0)return;let inp=r.querySelector('input');let p=parseInt(inp.dataset.price);let q=parseInt(inp.value)||0;let t=p*q;r.querySelector('.row-total').innerText=t.toLocaleString();pt+=t;});
document.querySelectorAll('#jerseys tr').forEach((r,i)=>{if(i==0)return;let inp=r.querySelector('input');let p=parseInt(inp.dataset.price);let q=parseInt(inp.value)||0;let t=p*q;r.querySelector('.row-total').innerText=t.toLocaleString();jt+=t;});
document.getElementById('total-products').innerText='Total Products: N'+pt.toLocaleString();
document.getElementById('total-jerseys').innerText='Total Jerseys: N'+jt.toLocaleString();
document.getElementById('grandTotal').innerText='GRAND TOTAL: N'+(pt+jt).toLocaleString();
}
function orderWhatsApp(){
let c=document.getElementById('custName').value||'Customer';
let s=document.getElementById('sellerName').value||'D-APEX';
let d=document.getElementById('orderDate').value;
let m='*D-APEX ORDER*%0A%0ACustomer: '+c+'%0ADate: '+d+'%0ASeller: '+s+'%0A%0A*PRODUCTS:*%0A';
document.querySelectorAll('#products tr').forEach((r,i)=>{if(i==0)return;let n=r.cells[1].innerText;let q=r.querySelector('input').value;let t=r.querySelector('.row-total').innerText;if(parseInt(q)>0)m+=n+' x'+q+' = N'+t+'%0A';});
m+='%0A*JERSEYS:*%0A';
document.querySelectorAll('#jerseys tr').forEach((r,i)=>{if(i==0)return;let n=r.cells[1].innerText;let q=r.querySelector('input').value;let t=r.querySelector('.row-total').innerText;if(parseInt(q)>0)m+=n+' Jersey x'+q+' = N'+t+'%0A';});
m+='%0A'+document.getElementById('total-products').innerText+'%0A'+document.getElementById('total-jerseys').innerText+'%0A*'+document.getElementById('grandTotal').innerText+'*%0A%0AShop Smart... Look Great!';
window.open('https://wa.me/2347067691468?text='+m,'_blank');
}
</script>
